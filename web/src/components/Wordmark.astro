---
/**
 * The "STASH" wordmark from the app's Home screen, as inline SVG.
 *
 * Path data comes from feature/home/src/main/res/drawable/wordmark_stash_dark.xml
 * (the Bungee Shade letters, SIL OFL, by David Jonathan Ross). One ink, like the
 * web player's logo: the light theme's dark base colour (the accent shade is
 * drawn in the same ink).
 */
interface Props {
  /** Rendered height in CSS units; the width follows the 4.56:1 aspect ratio. */
  height?: string;
  class?: string;
}

const { height = '1.5rem', class: className } = Astro.props;
---

<svg
  class:list={['wordmark', className]}
  style={`height: ${height}`}
  viewBox="0 0 500 100"
  role="img"
  aria-label="KRYPT AUDIO"
  xmlns="http://www.w3.org/2000/svg"
>
  <text x="0" y="76" class="wordmark-text">KRYPT AUDIO</text>
</svg>

<style>
  .wordmark {
    display: block;
    width: auto;
    aspect-ratio: 5 / 1;
    /* The light theme's #7C3AED and #1E0742 (the app's drawables). */
    --wordmark-accent: #7c3aed;
    --wordmark-base: #1e0742;
  }

  .wordmark-text {
    fill: var(--wordmark-base);
    font-family: system-ui, sans-serif;
    font-size: 72px;
    font-weight: 900;
    letter-spacing: 1px;
  }
  .accent {
    fill: var(--wordmark-base);
  }

  .base {
    fill: var(--wordmark-base);
  }
</style>
